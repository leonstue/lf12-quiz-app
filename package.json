{
  "name": "quiz-app",
  "version": "1.0.0",
  "private": true,
  "description": "Live-Quiz zu UML-Sequenzdiagrammen (Host/Beamer + Smartphone)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.41.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "prettier-plugin-svelte": "^3.3.3",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1",
    "svelte": "^5.20.4",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
