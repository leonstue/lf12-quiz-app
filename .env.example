# Oeffentliche Domain der Anwendung.
# Muss auf diesen Server zeigen (A-/AAAA-Record) und wird fuer das
# Let's-Encrypt-Zertifikat sowie den QR-Code in der Lobby verwendet.
DOMAIN=mycardbox.de

# E-Mail fuer Let's Encrypt (ACME-Registrierung, Ablaufwarnungen)
ACME_EMAIL=leon.stuempeley@gmx.de

# Host-Passwort. Leer lassen -- "make up" erzeugt automatisch ein sicheres Secret.
HOST_SECRET=

# Laufzeitumgebung des Node-Servers
NODE_ENV=production
